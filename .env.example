# Copy this file to .env and fill in your real values.
#   cp .env.example .env

# PostgreSQL connection string (SQLAlchemy format)
#   Local:    postgresql+psycopg2://postgres:postgres@localhost:5432/fraud_detection
#   Supabase: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/fraud_detection

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: key a background worker must send in X-Worker-Key
WORKER_API_KEY=

# Optional: LLM Provider for AI Explanation & Investigation Assistant (default is template fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cache & Background Worker (Redis / Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Risk Thresholds (0-30 Low, 31-70 Medium, 71-100 High)
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=70
CRITICAL_RISK_THRESHOLD=85
